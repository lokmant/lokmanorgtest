---
type Source = {
  title: string;
  id: string;
  url: string;
};

const sources: Source[] = [
  { title: "Videos", id: "videos", url: "https://www.lokman.org/videos/" },
  { title: "Podcasts", id: "podcasts", url: "https://www.lokman.org/podcasts/" },
  { title: "News media", id: "news-media", url: "https://www.lokman.org/newspapers/" },
];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${basePath}/`;
const writingsUrl = `${basePath}/essays-and-other-writings/`;
const academicUrl = `${basePath}/academic-work/`;

function cleanList(listHtml: string) {
  return listHtml.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");
}

function yearFor(listItem: string) {
  const years = [...listItem.matchAll(/\b(?:19|20)\d{2}\b/g)];
  return years.length ? Number(years.at(-1)?.[0]) : 0;
}

function groupNewsByYear(lists: string[]) {
  const entriesByYear = new Map<number, string[]>();

  for (const list of lists) {
    const items = cleanList(list).match(/<li\b[^>]*>[\s\S]*?<\/li>/gi) ?? [];
    for (const item of items) {
      const year = yearFor(item);
      entriesByYear.set(year, [...(entriesByYear.get(year) ?? []), item]);
    }
  }

  return [...entriesByYear.entries()]
    .sort(([firstYear], [secondYear]) => secondYear - firstYear)
    .map(([year, items]) => ({
      year,
      label: year ? String(year) : "Archive",
      html: `<ul>${items.join("")}</ul>`,
    }));
}

const sections = await Promise.all(
  sources.map(async (source) => {
    const response = await fetch(source.url);
    if (!response.ok) {
      throw new Error(`Could not load ${source.title} from ${source.url}`);
    }

    const html = await response.text();
    const article = html.match(/<article\b[^>]*>([\s\S]*?)<\/article>/i)?.[1] ?? "";
    const lists = article.match(/<ul\b[^>]*>[\s\S]*?<\/ul>/gi) ?? [];

    const groups = source.id === "news-media"
      ? groupNewsByYear(lists)
      : lists.map((list) => ({ year: 0, label: "", html: cleanList(list) }));

    return {
      ...source,
      groups: source.id === "news-media" ? groups.filter((group) => group.year >= 2022) : groups,
      earlierGroups: source.id === "news-media"
        ? groups.filter((group) => group.year > 0 && group.year < 2022)
        : [],
    };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Videos, podcasts, and news media featuring Lokman Tsui 徐洛文."
    />
    <title>Media appearances — Lokman Tsui 徐洛文</title>
  </head>

  <body>
    <header class="site-header">
      <a class="site-title" href={homeUrl}>lokman tsui 徐洛文</a>

      <nav aria-label="Primary navigation">
        <a href={homeUrl}>about</a>
        <a href={academicUrl}>academic work</a>
        <a href={writingsUrl}>
          essays and other writings
        </a>
        <a aria-current="page" href={homeUrl + "media-appearances/"}>
          media appearances
        </a>
      </nav>
    </header>

    <main>
      <article>
        <h1>media appearances</h1>

        <nav class="jump-links" aria-label="Media sections">
          {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
        </nav>

        {
          sections.map((section) => (
            <section id={section.id} class="media-section">
              <h2>{section.title}</h2>
              {section.groups.map((group, index) => (
                <div class="year-group">
                  {section.id === "news-media" && <h3>{group.label}</h3>}
                  <div class="entries" set:html={group.html} />
                  {index < section.groups.length - 1 && <hr />}
                </div>
              ))}
              {
                section.earlierGroups.length > 0 && (
                  <details class="earlier-news">
                    <summary>Earlier news media (2021 and earlier)</summary>
                    {section.earlierGroups.map((group, index) => (
                      <div class="year-group">
                        <h3>{group.label}</h3>
                        <div class="entries" set:html={group.html} />
                        {index < section.earlierGroups.length - 1 && <hr />}
                      </div>
                    ))}
                  </details>
                )
              }
            </section>
          ))
        }
      </article>
    </main>

    <footer>
      <a href="https://www.facebook.com/lokman.tsui.777/">Facebook</a>
      <a href="https://twitter.com/lokmantsui">Twitter</a>
      <a href="mailto:lokmantsui@protonmail.com">Email</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    color: #1c1c1c;
    background: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.65;
  }

  .site-header, main, footer {
    width: min(100% - 3rem, 1100px);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid #ddd;
  }

  .site-title { color: inherit; font-weight: 700; text-decoration: none; white-space: nowrap; }

  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem 1.2rem; }
  a { color: #1b4f72; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { text-decoration: underline; }

  main { padding-block: 4rem; }
  article { max-width: 850px; }
  h1 { margin-top: 0; font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; font-weight: 400; }
  h2 { margin-top: 4rem; font-size: 2rem; font-weight: 400; }
  h3 { margin: 2rem 0 0.75rem; font-size: 1.2rem; }

  .jump-links {
    justify-content: flex-start;
    gap: 0.5rem 1.25rem;
    padding: 1rem 0;
    border-block: 1px solid #ddd;
  }

  :global(.entries ul) { margin: 0; padding-left: 1.25rem; }
  :global(.entries li) { margin-block: 0.75rem; }
  hr { border: 0; border-top: 1px solid #ddd; margin: 2.5rem 0; }
  .earlier-news { margin-top: 2rem; border-top: 1px solid #ddd; }
  .earlier-news summary { padding: 1rem 0; cursor: pointer; font-weight: 700; }

  footer { display: flex; gap: 1rem; padding: 2rem 0 3rem; border-top: 1px solid #ddd; font-size: 0.9rem; }

  @media (max-width: 700px) {
    .site-header { display: block; }
    .site-header nav { justify-content: flex-start; margin-top: 1rem; }
    main { padding-block: 2.5rem; }
  }
</style>
