---
type Source = { title: string; id: string; url: string };

const sources: Source[] = [
  { title: "Essays", id: "essays", url: "https://www.lokman.org/essays/" },
  {
    title: "Home away from home",
    id: "home-away-from-home",
    url: "https://www.lokman.org/select-essays-and-other-writings/home-away-from-home/",
  },
  { title: "Op-eds", id: "op-eds", url: "https://www.lokman.org/op-eds/" },
];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${basePath}/`;

const sections = await Promise.all(
  sources.map(async (source) => {
    const response = await fetch(source.url);
    if (!response.ok) throw new Error(`Could not load ${source.title}`);

    const html = await response.text();
    const article = html.match(/<article\b[^>]*>([\s\S]*?)<\/article>/i)?.[1] ?? "";
    const groups = article.match(/<ul\b[^>]*>[\s\S]*?<\/ul>/gi) ?? [];

    return {
      ...source,
      groups: groups.map((group) =>
        group.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, ""),
      ),
    };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Essays and op-eds by Lokman Tsui 徐洛文."
    />
    <title>Essays and other writings — Lokman Tsui 徐洛文</title>
  </head>

  <body>
    <header class="site-header">
      <a class="site-title" href={homeUrl}>lokman tsui 徐洛文</a>
      <nav aria-label="Primary navigation">
        <a href={homeUrl}>about</a>
        <a href="https://www.lokman.org/academic-work/">academic work</a>
        <a aria-current="page" href={homeUrl + "essays-and-other-writings/"}>
          essays and other writings
        </a>
        <a href={homeUrl + "media-appearances/"}>media appearances</a>
      </nav>
    </header>

    <main>
      <article>
        <h1>essays and other writings</h1>
        <nav class="jump-links" aria-label="Writing sections">
          {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
        </nav>

        {
          sections.map((section) => (
            <section id={section.id} class="writing-section">
              <h2>{section.title}</h2>
              {section.groups.map((group, index) => (
                <div class="entries" set:html={group}>
                  {index < section.groups.length - 1 && <hr />}
                </div>
              ))}
            </section>
          ))
        }
      </article>
    </main>

    <footer>
      <a href="https://www.facebook.com/lokman.tsui.777/">Facebook</a>
      <a href="https://twitter.com/lokmantsui">Twitter</a>
      <a href="mailto:lokmantsui@protonmail.com">Email</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    color: #1c1c1c;
    background: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.65;
  }
  .site-header, main, footer { width: min(100% - 3rem, 1100px); margin-inline: auto; }
  .site-header { display: flex; justify-content: space-between; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid #ddd; }
  .site-title { color: inherit; font-weight: 700; text-decoration: none; white-space: nowrap; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem 1.2rem; }
  a { color: #1b4f72; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { text-decoration: underline; }
  main { padding-block: 4rem; }
  article { max-width: 850px; }
  h1 { margin-top: 0; font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; font-weight: 400; }
  h2 { margin-top: 4rem; font-size: 2rem; font-weight: 400; }
  .jump-links { justify-content: flex-start; gap: 0.5rem 1.25rem; padding: 1rem 0; border-block: 1px solid #ddd; }
  :global(.entries ul) { margin: 0; padding-left: 1.25rem; }
  :global(.entries li) { margin-block: 0.75rem; }
  hr { border: 0; border-top: 1px solid #ddd; margin: 2.5rem 0; }
  footer { display: flex; gap: 1rem; padding: 2rem 0 3rem; border-top: 1px solid #ddd; font-size: 0.9rem; }
  @media (max-width: 700px) {
    .site-header { display: block; }
    .site-header nav { justify-content: flex-start; margin-top: 1rem; }
    main { padding-block: 2.5rem; }
  }
</style>
