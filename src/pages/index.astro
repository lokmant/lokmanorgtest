---
const imageUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/lokman.png`;
const mediaUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/media-appearances/`;
const writingsUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/essays-and-other-writings/`;
const academicUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/academic-work/`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Lokman Tsui 徐洛文 — writer, academic, and amateur activist."
        />
        <title>Lokman Tsui 徐洛文</title>
    </head>

    <body>
        <header class="site-header">
            <a class="site-title" href="./">lokman tsui 徐洛文</a>

            <nav aria-label="Primary navigation">
                <a aria-current="page" href="./">about</a>
                <a href={academicUrl}>academic work</a>
                <a href={writingsUrl}>
                    essays and other writings
                </a>
                <a href={mediaUrl}>media appearances</a>
            </nav>
        </header>

        <main>
            <article>
                <section class="hero">
                    <div>
                        <h1>Lokman Tsui 徐洛文</h1>
                        <p class="tagline">
                            Writer, researcher, and amateur activist on free
                            expression, authoritarianism, and technology.
                        </p>
                        <p class="roles">
                            Assistant Professor, Graduate Institute of Journalism,
                            National Taiwan University<br />
                            Senior Research Fellow, Citizen Lab, University of Toronto
                        </p>
                    </div>

                    <figure>
                        <img
                            src={imageUrl}
                            alt="Portrait of Lokman Tsui"
                            width="800"
                        />
                    </figure>
                </section>

                <p>
                    My work focuses on free expression and authoritarianism,
                    with particular attention to new technologies and Hong Kong.
                    I’m working on a book, a personal history of authoritarianism
                    at home.
                </p>

                <p>
                    Before I joined National Taiwan University, I was an
                    Assistant Professor at the School of Journalism and
                    Communication of the Chinese University of Hong Kong
                    (2014–2021).
                </p>

                <p>
                    Before CUHK, I was Google’s Head of Free Expression for Asia
                    and the Pacific (2011–2014) and an Assistant Professor in
                    Media and Communication at City University of Hong Kong
                    (2010–2011). I received my PhD from the Annenberg School for
                    Communication at the University of Pennsylvania.
                </p>

                <p>
                    To contact me, email{" "}
                    <a href="mailto:lokmantsui@protonmail.com">
                        lokmantsui@protonmail.com
                    </a>.
                </p>
            </article>
        </main>

        <footer>
            <a href="https://www.facebook.com/lokman.tsui.777/">Facebook</a>
            <a href="https://twitter.com/lokmantsui">Twitter</a>
            <a href="mailto:lokmantsui@protonmail.com">Email</a>
        </footer>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        color: #1c1c1c;
        background: #fff;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        line-height: 1.65;
    }

    .site-header,
    main,
    footer {
        width: min(100% - 3rem, 1100px);
        margin-inline: auto;
    }

    .site-header {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        padding: 2rem 0;
        border-bottom: 1px solid #ddd;
    }

    .site-title {
        color: inherit;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.4rem 1.2rem;
    }

    a {
        color: #1b4f72;
    }

    nav a {
        color: inherit;
        text-decoration: none;
    }

    nav a:hover,
    nav a[aria-current="page"] {
        text-decoration: underline;
    }

    main {
        padding-block: 4rem;
    }

    article {
        max-width: 900px;
    }

    h1 {
        margin-top: 0;
        font-size: clamp(2.2rem, 6vw, 4rem);
        line-height: 1;
        font-weight: 400;
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
        align-items: start;
        gap: 3rem;
        margin-bottom: 2.5rem;
    }

    .hero figure {
        margin: 0;
    }

    .hero img {
        display: block;
        width: 100%;
        height: auto;
    }

    .tagline {
        margin: 1rem 0 1.5rem;
        font-size: 1.35rem;
        line-height: 1.4;
    }

    .roles {
        margin: 0;
        font-size: 1rem;
        line-height: 1.5;
    }

    footer {
        display: flex;
        gap: 1rem;
        padding: 2rem 0 3rem;
        border-top: 1px solid #ddd;
        font-size: 0.9rem;
    }

    @media (max-width: 700px) {
        .site-header {
            display: block;
        }

        nav {
            justify-content: flex-start;
            margin-top: 1rem;
        }

        main {
            padding-block: 2.5rem;
        }

        .hero {
            display: block;
        }

        .hero figure {
            width: min(100%, 420px);
            margin-top: 2rem;
        }
    }
</style>
