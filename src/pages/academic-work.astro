---
type Source = { title: string; id: string; url: string };

const sources: Source[] = [
  {
    title: "Journal articles",
    id: "journal-articles",
    url: "https://www.lokman.org/academic-work/journal-articles/",
  },
  { title: "Books", id: "books", url: "https://www.lokman.org/academic-work/books/" },
  {
    title: "Research reports",
    id: "research-reports",
    url: "https://www.lokman.org/academic-work/research-reports/",
  },
  {
    title: "Book reviews",
    id: "book-reviews",
    url: "https://www.lokman.org/academic-work/book-reviews/",
  },
];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${basePath}/`;

function articleContent(html: string) {
  const article = html.match(/<article\b[^>]*>([\s\S]*?)<\/article>/i)?.[1] ?? "";
  return article
    .replace(/<header\b[^>]*>[\s\S]*?<\/header>/i, "")
    .replace(/<h1\b[^>]*>[\s\S]*?<\/h1>/i, "")
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");
}

const sections = await Promise.all(
  sources.map(async (source) => {
    const response = await fetch(source.url);
    if (!response.ok) throw new Error(`Could not load ${source.title}`);
    return { ...source, html: articleContent(await response.text()) };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Academic work by Lokman Tsui 徐洛文." />
    <title>Academic work — Lokman Tsui 徐洛文</title>
  </head>

  <body>
    <header class="site-header">
      <a class="site-title" href={homeUrl}>lokman tsui 徐洛文</a>
      <nav aria-label="Primary navigation">
        <a href={homeUrl}>about</a>
        <a aria-current="page" href={homeUrl + "academic-work/"}>academic work</a>
        <a href={homeUrl + "essays-and-other-writings/"}>essays and other writings</a>
        <a href={homeUrl + "media-appearances/"}>media appearances</a>
      </nav>
    </header>

    <main>
      <article>
        <h1>academic work</h1>
        <nav class="jump-links" aria-label="Academic work sections">
          {sections.slice(0, 3).map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
          <a href="#dissertation">Dissertation</a>
          <a href="#book-reviews">Book reviews</a>
        </nav>

        {
          sections.slice(0, 3).map((section) => (
            <section id={section.id} class="academic-section">
              <h2>{section.title}</h2>
              <div class="entries" set:html={section.html} />
            </section>
          ))
        }

        <section id="dissertation" class="academic-section dissertation">
          <h2>Dissertation</h2>
          <p>
            <a href="https://www.lokman.org/academic-work/dissertation/">
              A Journalism of Hospitality
            </a>
            , PhD dissertation, Annenberg School for Communication, University of Pennsylvania.
          </p>
          <p><a href="https://www.lokman.org/academic-work/dissertation/">Read the dissertation page →</a></p>
        </section>

        {
          sections.slice(3).map((section) => (
            <section id={section.id} class="academic-section">
              <h2>{section.title}</h2>
              <div class="entries" set:html={section.html} />
            </section>
          ))
        }
      </article>
    </main>

    <footer>
      <a href="https://www.facebook.com/lokman.tsui.777/">Facebook</a>
      <a href="https://twitter.com/lokmantsui">Twitter</a>
      <a href="mailto:lokmantsui@protonmail.com">Email</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #1c1c1c; background: #fff; font-family: Georgia, "Times New Roman", serif; font-size: 18px; line-height: 1.65; }
  .site-header, main, footer { width: min(100% - 3rem, 1100px); margin-inline: auto; }
  .site-header { display: flex; justify-content: space-between; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid #ddd; }
  .site-title { color: inherit; font-weight: 700; text-decoration: none; white-space: nowrap; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem 1.2rem; }
  a { color: #1b4f72; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { text-decoration: underline; }
  main { padding-block: 4rem; }
  article { max-width: 850px; }
  h1 { margin-top: 0; font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; font-weight: 400; }
  h2 { margin-top: 4rem; font-size: 2rem; font-weight: 400; }
  .jump-links { justify-content: flex-start; gap: 0.5rem 1.25rem; padding: 1rem 0; border-block: 1px solid #ddd; }
  :global(.entries ul) { padding-left: 1.25rem; }
  :global(.entries li) { margin-block: 0.75rem; }
  :global(.entries p) { margin-block: 1rem; }
  .dissertation { padding: 0.5rem 1.5rem 1rem; border-left: 3px solid #1b4f72; background: #f7fafc; }
  footer { display: flex; gap: 1rem; padding: 2rem 0 3rem; border-top: 1px solid #ddd; font-size: 0.9rem; }
  @media (max-width: 700px) { .site-header { display: block; } .site-header nav { justify-content: flex-start; margin-top: 1rem; } main { padding-block: 2.5rem; } }
</style>
